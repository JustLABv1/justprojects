DATABASE_SERVER=localhost
DATABASE_PORT=5432
DATABASE_NAME=justprojects
DATABASE_USER=justprojects
DATABASE_PASSWORD=justprojects
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_IDLE=5m
HTTP_ADDR=:8080
WORKER_POLL_INTERVAL=5s
# Background provider polling interval. Webhooks remain preferred when available.
GIT_SYNC_INTERVAL=5m
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=justprojects_session
SESSION_TTL=720h
SECURE_COOKIES=false
# Optional comma-separated recovery/admin accounts. Existing installations
# can also use the oldest account, which is promoted by the platform migration.
PLATFORM_ADMIN_EMAILS=
# Use a stable 32-byte hex/base64 key outside local development.
APP_ENCRYPTION_KEY=

# GitHub OAuth (optional; the App is preferred for organization repositories).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# OIDC (optional).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
